SUPABASE_URL=https://your-project-ref.supabase.co
# Recommended for the server-side API routes.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Optional fallback for read/write only if your RLS policies allow it.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional private gate for deployed app API routes.
# APP_ACCESS_CODE=change-me

# Optional for model-backed analysis. Without it the app uses deterministic local analysis.
# DASHSCOPE_API_KEY=sk-xxx
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
#
# OpenAI-compatible fallback names also work:
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini
